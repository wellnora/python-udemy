#!/usr/bin/python3
# Temple Run Game Script
# This script creates a simple Temple Run-like game

import pygame
import random
import time

def main():
    # Initialize Pygame
    pygame.init()
    
    # Set up display
    width, height = 800, 600
    screen = pygame.display.set_mode((width, height))
    pygame.display.set_caption("Temple Run")
    
    # Load assets
    player_img = pygame.image.load('player.png')
    obstacle_img = pygame.image.load('obstacle.png')
    
    # Game variables
    player_x = 100
    player_y = height - 100
    player_speed = 5
    
    obstacle_x = width
    obstacle_y = random.randint(0, height - obstacle_img.get_height())
    obstacle_speed = 5
    
    # Game loop
    running = True
    clock = pygame.time.Clock()
    
    while running:
        # Event handling
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
                
        # Player movement
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and player_x > 0:
            player_x -= player_speed
        if keys[pygame.K_RIGHT] and player_x < width - player_img.get_width():
            player_x += player_speed
            
        # Obstacle movement
        obstacle_x -= obstacle_speed
        
        # Collision detection
        if obstacle_x < player_x + player_img.get_width() and \
           obstacle_x + obstacle_img.get_width() > player_x and \
           obstacle_y < player_y + player_img.get_height() and \
           obstacle_y + obstacle_img.get_height() > player_y:
            print("Game Over!")
            running = False
            
        # Reset obstacle if it goes off screen
        if obstacle_x < -obstacle_img.get_width():
            obstacle_x = width
            obstacle_y = random.randint(0, height - obstacle_img.get_height())
            
        # Drawing
        screen.fill((255, 255, 255))
        screen.blit(player_img, (player_x, player_y))
        screen.blit(obstacle_img, (obstacle_x, obstacle_y))
        
        # Update display
        pygame.display.flip()
        
        # Cap the frame rate
        clock.tick(60)
    
    # Clean up
    pygame.quit()

if __name__ == "__main__":
    main()
